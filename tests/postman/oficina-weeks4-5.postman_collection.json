    {
      "name": "03 - Autenticacao serverless e seguranca",
      "item": [
        {
          "name": "Autenticar proprietario por CPF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"cpf\":\"{{ownerCpf}}\"}"
            },
            "url": "{{authBaseUrl}}/auth/cpf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('CPF ativo recebe token', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json.tokenType).to.equal('Bearer');",
                  "pm.collectionVariables.set('ownerToken', json.accessToken);",
                  "let payload = json.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "while (payload.length % 4) payload += '=';",
                  "const claims = JSON.parse(atob(payload));",
                  "pm.expect(String(claims.sub)).to.equal(String(pm.collectionVariables.get('ownerClientId')));",
                  "pm.expect(claims.role).to.equal('CLIENTE');",
                  "pm.expect(JSON.stringify(claims)).not.to.include(pm.collectionVariables.get('ownerCpf'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Autenticar segundo cliente por CPF",
