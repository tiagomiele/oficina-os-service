                  "  pm.response.to.have.status(200);",
                  "  const history = pm.response.json();",
                  "  pm.expect(history.map(item => item.status)).to.include.members(['RECEBIDA', 'EM_DIAGNOSTICO', 'AGUARDANDO_APROVACAO', 'EM_EXECUCAO', 'AGUARDANDO_PAGAMENTO', 'PAGA', 'ENTREGUE']);",
                  "  pm.expect(history.every(item => item.correlationId && item.correlationId.length <= 64)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
