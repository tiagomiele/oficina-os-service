  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  const seed = String(Date.now()).slice(-9).padStart(9, '1');",
          "  const cpf = (base) => {",
          "    let digits = base.split('').map(Number);",
          "    const check = (values, start) => {",
          "      const sum = values.reduce((acc, value, index) => acc + value * (start - index), 0);",
          "      const remainder = (sum * 10) % 11;",
          "      return remainder === 10 ? 0 : remainder;",
          "    };",
          "    digits.push(check(digits, 10));",
          "    digits.push(check(digits, 11));",
          "    return digits.join('');",
          "  };",
          "  const runId = String(Date.now());",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('ownerCpf', cpf(seed));",
          "  pm.collectionVariables.set('otherCpf', cpf(String(Number(seed) + 101).padStart(9, '2').slice(-9)));",
          "  pm.collectionVariables.set('vehiclePlate', `TST${runId.slice(-3, -2)}A${runId.slice(-2)}`);",
          "  pm.collectionVariables.set('serviceName', `Validacao ${runId}`);",
          "  pm.collectionVariables.set('technicianEmail', `tecnico-${runId}@teste.local`);",
          "}"
        ]
      }
    }
  ],
